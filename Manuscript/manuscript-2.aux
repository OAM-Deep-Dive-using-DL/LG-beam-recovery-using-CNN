\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Neural receiver inference architecture. Intensity-only input flows through stem adaptation, backbone, and a projection head that regresses $M$ complex QPSK symbols. BER/SER is evaluated at coded level (QPSK demodulation to bits). No LDPC decoding stage is used here, allowing direct comparison with the classical chain at pre-LDPC level.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:neural_inference}{{4}{6}{Neural receiver inference architecture. Intensity-only input flows through stem adaptation, backbone, and a projection head that regresses $M$ complex QPSK symbols. BER/SER is evaluated at coded level (QPSK demodulation to bits). No LDPC decoding stage is used here, allowing direct comparison with the classical chain at pre-LDPC level}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Curriculum learning training pipeline. Five sequential stages from ideal/very weak ($C_n^2 \approx 10^{-18}$--$10^{-17}$) to extreme ($C_n^2 = 10^{-14}$--$10^{-12}$) turbulence. Weights from each stage are frozen and transferred to the next; Polar Loss and validation-driven checkpointing are applied per stage.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:neural_curriculum}{{5}{6}{Curriculum learning training pipeline. Five sequential stages from ideal/very weak ($C_n^2 \approx 10^{-18}$--$10^{-17}$) to extreme ($C_n^2 = 10^{-14}$--$10^{-12}$) turbulence. Weights from each stage are frozen and transferred to the next; Polar Loss and validation-driven checkpointing are applied per stage}{figure.5}{}}
